{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "log_window"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "dialog:allow-open",
    "updater:default"
  ]
}
